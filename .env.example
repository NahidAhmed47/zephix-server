# ---- App ----
PORT=5006
NODE_ENV=development
ADMIN_CLIENT_URL=http://localhost:3000
SERVER_BASE_URL=http://localhost:5006
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
MONGODB_URL=mongodb://127.0.0.1:27017/zephix_os

# ---- Auth (JWT) ----
JWT_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=365d

# ---- Security ----
# 32+ char secret used to encrypt SMS/SMTP credentials at rest
ENCRYPTION_KEY=change-me-32-bytes-minimum-secret-key
# Secret required by POST /api/v1/internal/cron/* endpoints
CRON_SECRET=change-me-cron-secret

# ---- Money ----
DEFAULT_CURRENCY=BDT

# ---- BulkSMSBD (server-only, never sent to browser) ----
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=http://bulksmsbd.net/api/smsapi
SMS_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi

# ---- SMTP (server-only) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Zephix
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# ---- AWS S3 (documents) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FILE_LOAD_BASE_URL=
